//@version=6
// EMA crossover + RSI filter, long only.
// Paste into TradingView's Pine Editor, "Add to chart", then create an alert on it
// (see README.md for the exact alert message and webhook URL).
strategy("EMA Cross + RSI (webhook)", overlay = true,
     initial_capital = 10000, default_qty_type = strategy.percent_of_equity, default_qty_value = 10,
     commission_type = strategy.commission.percent, commission_value = 0.05)

fastLen  = input.int(9,  "Fast EMA")
slowLen  = input.int(21, "Slow EMA")
rsiLen   = input.int(14, "RSI length")
rsiMaxIn = input.int(70, "Don't buy if RSI above")
stopPct  = input.float(3.0, "Stop loss %", step = 0.5)
tpPct    = input.float(6.0, "Take profit %", step = 0.5)

fast = ta.ema(close, fastLen)
slow = ta.ema(close, slowLen)
rsi  = ta.rsi(close, rsiLen)

longSignal = ta.crossover(fast, slow) and rsi < rsiMaxIn
exitSignal = ta.crossunder(fast, slow)

if longSignal and strategy.position_size == 0
    strategy.entry("Long", strategy.long)

if strategy.position_size > 0
    entry = strategy.position_avg_price
    strategy.exit("SL/TP", "Long", stop = entry * (1 - stopPct / 100), limit = entry * (1 + tpPct / 100))

if exitSignal
    strategy.close("Long", comment = "EMA cross down")

plot(fast, "Fast EMA", color.new(color.teal, 0), 2)
plot(slow, "Slow EMA", color.new(color.orange, 0), 2)
plotshape(longSignal, "Buy", shape.triangleup, location.belowbar, color.green, size = size.small)
plotshape(exitSignal, "Exit", shape.triangledown, location.abovebar, color.red, size = size.small)
